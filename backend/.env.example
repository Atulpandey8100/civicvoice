PORT=5000
MONGODB_URI=mongodb://localhost:27017/civicvoice
JWT_SECRET=your_jwt_secret_here
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP for OTP emails (free service: e.g. Brevo -> smtp-relay.brevo.com:587)
# If not configured, the OTP is logged to the server console instead.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_user
SMTP_PASS=your_brevo_smtp_key
MAIL_FROM=CivicVoice <sender@example.com>

# Admin bootstrap (npm run seed:admin)
ADMIN_NAME=CivicVoice Admin
ADMIN_EMAIL=admin@civicvoice.local
ADMIN_PASSWORD=ChangeMe123!
