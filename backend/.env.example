# Server
PORT=5000

# MongoDB (local default: mongodb://localhost:27017/civicvoice)
MONGODB_URI=mongodb://localhost:27017/civicvoice

# Auth
JWT_SECRET=change-me

# Gemini AI (issue priority analysis)
GEMINI_API_KEY=

# CORS (comma-separated origins, or empty for allow-all)
CORS_ORIGIN=

# ImageKit (optional - used for cloud image storage)
# If left blank, images are stored locally under backend/uploads and served at /uploads
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# SMTP for OTP emails (free service: e.g. Brevo -> smtp-relay.brevo.com:587)
# If not configured, the OTP is logged to the server console instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Admin bootstrap (npm run seed:admin)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
